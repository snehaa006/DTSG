# Render API base URL. Local dev points at the uvicorn dev server; in Vercel set
# this to the deployed Render service, e.g. https://dtsg-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Stand-in identity until auth lands. Any UUID works; the backend only uses it
# to scope events and memories.
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001
