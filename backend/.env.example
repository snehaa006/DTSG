# Supabase transaction pooler URI (port 6543), NOT db.<ref>.supabase.co:5432 —
# the direct host is IPv6-only and Render dials out over IPv4.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql://postgres.sqplfrommcmmqitzqkss:<PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# Anthropic. Haiku does extraction/classification, Sonnet writes answers.
ANTHROPIC_API_KEY=sk-ant-...
MODEL_FAST=claude-haiku-4-5
MODEL_SMART=claude-sonnet-5

# Embeddings. Must be a 1536-dim model to match vector(1536) in the schema.
EMBEDDING_API_KEY=sk-...
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
